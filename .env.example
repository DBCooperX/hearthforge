# Your Anthropic API key (https://platform.claude.com). Without it the game still runs,
# with scripted monsters and canned narration instead of the AI Dungeon Master.
ANTHROPIC_API_KEY=

# The Dungeon Master picks a model for each moment, so you only pay for the big one when it matters:
#   background  memory summaries and routine beats (short travel, rests)
#   standard    everyday narration, conversation and monster turns
#   key         the opening scene, first arrival at a major place, boss fights, level-ups,
#               defeats, and any turn the DM itself flagged as a turning point
# Leave these commented out to use the defaults shown.
#HEARTHFORGE_DM_MODEL_BACKGROUND=claude-haiku-5-5
#HEARTHFORGE_DM_MODEL_STANDARD=claude-sonnet-5-5
#HEARTHFORGE_DM_MODEL_KEY=claude-opus-5-5

# Set this to run everything on one model instead, for example claude-opus-5-5 or claude-fable-5-2.
#HEARTHFORGE_DM_FORCE_MODEL=
# on: every story turn outside fights runs on the key-moment model (a comparison session).
#HEARTHFORGE_DM_STORY_ON_KEY=off

# How hard the DM thinks per beat: low | medium | high. Low keeps turns snappy.
HEARTHFORGE_DM_EFFORT=low

# Art: generated (built-in pixel art), kenney or 0x72. This is only the starting point:
# packs are added and switched in the game, in the Innkeeper under Assets (see "Art packs"
# in the README). HEARTHFORGE_ART_UPLOADS=off locks that. Kenney and 0x72 do not allow
# automatic downloads: download the zip from the pack's page and drop it in the Innkeeper
# (or copy it into the art folder); until then the game keeps the built-in pixel art.
HEARTHFORGE_ART=generated

# Background music: on or off. Tracks (CC BY 4.0, about 100 MB) are downloaded on start into
# the data volume; see "Music" in the README. Players can mute it for themselves in the game.
HEARTHFORGE_MUSIC=on

# Seconds the Dungeon Master waits for the other players after the first one acts in the story,
# so their actions are resolved together. 0 answers every action at once.
HEARTHFORGE_TURN_WAIT=8

# Seconds a player gets to decide on an opportunity attack when an enemy leaves their hero's
# reach. After that the hero strikes. 0 never asks: every hero follows its own setting.
HEARTHFORGE_REACTION_WAIT=20

# Port on the host.
HEARTHFORGE_PORT=3000

# The Innkeeper is the owner's panel in the game (http://<address>:<port>/?innkeeper). Everything
# in this file except the port can also be changed there, and a value set there wins.
# First password for it. The installer writes one here; without one the server makes one up and
# prints it in its log. It is only read until you change the password in the panel.
#HEARTHFORGE_ADMIN_PASSWORD=
# off removes the Innkeeper altogether.
#HEARTHFORGE_ADMIN=on
# on installs a new version from GitHub by itself whenever nobody sits at a table.
#HEARTHFORGE_AUTO_UPDATE=off
# on reads a player's address from X-Forwarded-For. Only behind your own reverse proxy.
#HEARTHFORGE_TRUST_PROXY=off

# ------------------------------------------------------------------ narrator (reads the story aloud)
# Piper is part of the image and speaks on this server's CPU, for free. Its voices (about 60 to 120 MB each) are
# downloaded from Piper's collection the first time. The voice is chosen in the Innkeeper under Assets → Narrator;
# players can mute it or turn it down. off removes the narrator altogether.
#HEARTHFORGE_NARRATOR=on
# Optional hosted voices that sound like a real audiobook narrator. A few cents per evening.
#OPENAI_API_KEY=
#ELEVENLABS_API_KEY=

# ------------------------------------------------------------------ HTTPS (needed for voice input)
# Browsers only allow the microphone on https. Uncomment the next line to start Caddy in front of the game,
# then set a domain, local addresses, or both. See "HTTPS" in the README.
#COMPOSE_PROFILES=https
# A domain that points at this server, with ports 80 and 443 reachable from the internet: a free certificate
# from Let's Encrypt, renewed by itself.
#HEARTHFORGE_DOMAIN=dnd.example.ch
#HEARTHFORGE_ACME_EMAIL=
# A domain that only exists inside your network: Let's Encrypt checks a DNS record instead. The provider is the
# name of a plugin from github.com/caddy-dns (cloudflare, duckdns, hetzner or digitalocean); the token is
# an API token of that provider that may edit DNS records.
#HEARTHFORGE_DNS_PROVIDER=
#HEARTHFORGE_DNS_TOKEN=
# Without a domain: addresses that get a certificate from Caddy's own local authority, for example this
# server's IP. Each device trusts it once, from http://<address>/hearthforge-ca.crt.
#HEARTHFORGE_LOCAL_HOSTS=192.168.1.50
#HEARTHFORGE_HTTP_PORT=80
#HEARTHFORGE_HTTPS_PORT=443
